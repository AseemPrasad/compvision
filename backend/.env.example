# ==========================================================================
# IBVAP - Intelligent Border Video Analytics Platform
# Environment Configuration Example
# Copy this file to `.env` and adjust values for your deployment.
# ==========================================================================

# --- Server ---
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# --- Database ---
DB_PATH=./ibvap.db

# --- Storage ---
SNAPSHOT_DIR=./storage/snapshots
CLIP_DIR=./storage/clips

# --- Vision Engine ---
YOLO_MODEL_PATH=./assets/models/yolo11n.onnx
YOLO_INPUT_SIZE=640
YOLO_CONFIDENCE_THRESHOLD=0.45
YOLO_IOU_THRESHOLD=0.45
MAX_PROCESSING_WIDTH=640

# Frame throttling: run heavy analytics (ANPR / Face) every N frames
ANALYTICS_FRAME_INTERVAL=7

# ANPR multi-frame consensus: how many matching plausible plate reads are
# needed to finalize early (works well for stationary/slow vehicles), and
# the max attempts to spend before falling back to the best single reading
# (needed for vehicles only briefly in frame, e.g. fast-moving traffic).
ANPR_CONSENSUS_COUNT=2
ANPR_MAX_ATTEMPTS=5

# Live viewer: broadcast a JPEG preview frame every N processed frames
# (higher = less bandwidth, choppier preview; lower = smoother, more bandwidth)
FRAME_BROADCAST_INTERVAL=2

# --- Face Recognition ---
FACE_MODELS_PATH=./assets/models/face-api-models
FACE_MATCH_DISTANCE_THRESHOLD=0.5

# --- Camera / Stream ---
# Example RTSP source for a Wi-Fi IP Webcam Android app:
#   rtsp://192.168.1.15:8080/h264_pcm.sdp
DEFAULT_RECONNECT_BASE_DELAY_MS=1000
DEFAULT_RECONNECT_MAX_DELAY_MS=30000
DEFAULT_RECONNECT_MAX_ATTEMPTS=0

# --- Timezone ---
APP_TIMEZONE=Asia/Kolkata

# --- Night Window (IST, 24h clock) ---
NIGHT_START_HOUR=19
NIGHT_END_HOUR=6

# --- Virtual Fencing (SpatialEngine) ---
# Minimum consecutive frames a spatial state must hold before a transition
# is confirmed (frame-based debounce).
FENCE_DEBOUNCE_FRAMES=3
# Minimum confirmed track-hits before a track is trusted enough to trigger
# a crossing event (guards against a freshly-spawned/re-IDed track).
FENCE_MIN_TRACK_AGE_HITS=10
# Minimum wall-clock milliseconds between repeat crossing events for the
# same track+zone pair (time-based debounce, independent of frame count).
FENCE_EVENT_DEBOUNCE_MS=10000

# --- Behavioral Analytics (BehaviorEngine) ---
# Running: px/frame velocity threshold above which a person is flagged as running
BEHAVIOR_RUNNING_VELOCITY_THRESHOLD=30
# How many consecutive high-velocity frames needed to confirm running
BEHAVIOR_RUNNING_CONFIRM_FRAMES=5
# Crawling: box height must drop below this fraction of initial height
BEHAVIOR_CRAWLING_HEIGHT_RATIO=0.4
# Climbing: upward velocity (px/frame, negative = going up in pixel coords)
BEHAVIOR_CLIMBING_VELOCITY_THRESHOLD=-15
BEHAVIOR_CLIMBING_CONFIRM_FRAMES=5
# Crowd surge: max persons allowed in a zone before triggering alert
BEHAVIOR_CROWD_THRESHOLD=5
# Loitering: seconds a person must dwell before triggering
LOITERING_THRESHOLD_SECONDS=45

# --- Camera Tampering Detection (TamperDetector) ---
# Freeze: consecutive near-identical frames before declaring freeze
TAMPER_FREEZE_FRAME_COUNT=10
# Darkness: mean brightness below this (0-1) for N frames
TAMPER_DARKNESS_THRESHOLD=0.02
TAMPER_DARKNESS_FRAME_COUNT=5
# Overexposure: mean brightness above this (0-1) for N frames
TAMPER_BRIGHTNESS_THRESHOLD=0.95
TAMPER_BRIGHTNESS_FRAME_COUNT=3
# Obstruction: average frame contrast below this (0-1) for N frames
TAMPER_CONTRAST_THRESHOLD=0.05
TAMPER_OBSTRUCTION_FRAME_COUNT=30

# --- Email Alerting (Mailer) ---
# SMTP credentials — replace with real values
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
# Alert sender display name
ALERT_SENDER_NAME=IBVAP Border Surveillance Alert
# Recipients — at least one required for alerts to send
ALERT_RECIPIENT_1=head@example.gov.in
ALERT_RECIPIENT_2=operator@example.gov.in
ALERT_RECIPIENT_3=gate@example.gov.in
# Cooldown between repeat emails per event (milliseconds)
ALERT_EMAIL_COOLDOWN_MS=300000

# --- SMS Alerting (SMSAlert) ---
# SMS provider: 'gateway' (HTTP API) or 'gsmmodem' (USB serial)
SMS_PROVIDER=gateway
# Gateway mode: HTTP POST to SMS API (Twilio, MSG91, etc.)
SMS_GATEWAY_URL=https://api.twilio.com/2010-04-01/Accounts/YOUR_ACCOUNT_SID/Messages.json
SMS_GATEWAY_API_KEY=your_sms_api_key
SMS_GATEWAY_API_SECRET=your_sms_api_secret
SMS_FROM_NUMBER=+1234567890
# GSM modem mode (when SMS gateway is unreachable)
GSM_MODEM_PORT=/dev/ttyUSB0
GSM_MODEM_BAUD=115200
# Comma-separated list of alert phone numbers
ALERT_PHONE_NUMBERS=+919876543210,+919876543211
# Whether to send SMS for P2_MEDIUM events (true) or only P0/P1 (false)
SMS_INCLUDE_MEDIUM=false

# --- C2 Integration ---
# Comma-separated webhook URLs — each event fires an HTTP POST to all URLs
C2_WEBHOOK_URLS=
# Include snapshot JPEG as base64 in webhook payload (true) or just event data (false)
C2_WEBHOOK_INCLUDE_SNAPSHOT=false
# MQTT broker (optional — leave blank to disable)
MQTT_BROKER_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=ibvap/events
# ATAK / COT multicast address and port
TAK_ENABLED=false
TAK_MULTICAST_ADDR=224.0.0.2
TAK_MULTICAST_PORT=6969

# --- Radio Alerting (RadioAlert) ---
# Serial port for radio PTT trigger (leave blank to disable)
RADIO_SERIAL_PORT=
RADIO_SERIAL_BAUD=9600
# DTMF tone sequences per event type (used to trigger radio alerts)
RADIO_TONE_INBOUND=123
RADIO_TONE_OUTBOUND=1234
RADIO_TONE_CRITICAL=999
