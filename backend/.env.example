# ==========================================================================
# IBVAP - Intelligent Border Video Analytics Platform
# Environment Configuration Example
# Copy this file to `.env` and adjust values for your deployment.
# ==========================================================================

# --- Server ---
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# --- Database ---
DB_PATH=./ibvap.db

# --- Storage ---
SNAPSHOT_DIR=./storage/snapshots
CLIP_DIR=./storage/clips

# --- Vision Engine ---
YOLO_MODEL_PATH=./assets/models/yolo11n.onnx
YOLO_INPUT_SIZE=640
YOLO_CONFIDENCE_THRESHOLD=0.45
YOLO_IOU_THRESHOLD=0.45
MAX_PROCESSING_WIDTH=640

# Frame throttling: run heavy analytics (ANPR / Face) every N frames
ANALYTICS_FRAME_INTERVAL=7

# ANPR multi-frame consensus: how many matching plausible plate reads are
# needed to finalize early (works well for stationary/slow vehicles), and
# the max attempts to spend before falling back to the best single reading
# (needed for vehicles only briefly in frame, e.g. fast-moving traffic).
ANPR_CONSENSUS_COUNT=2
ANPR_MAX_ATTEMPTS=5

# Live viewer: broadcast a JPEG preview frame every N processed frames
# (higher = less bandwidth, choppier preview; lower = smoother, more bandwidth)
FRAME_BROADCAST_INTERVAL=2

# --- Face Recognition ---
FACE_MODELS_PATH=./assets/models/face-api-models
FACE_MATCH_DISTANCE_THRESHOLD=0.5

# --- Camera / Stream ---
# Example RTSP source for a Wi-Fi IP Webcam Android app:
#   rtsp://192.168.1.15:8080/h264_pcm.sdp
DEFAULT_RECONNECT_BASE_DELAY_MS=1000
DEFAULT_RECONNECT_MAX_DELAY_MS=30000
DEFAULT_RECONNECT_MAX_ATTEMPTS=0

# --- Timezone ---
APP_TIMEZONE=Asia/Kolkata

# --- Night Window (IST, 24h clock) ---
NIGHT_START_HOUR=19
NIGHT_END_HOUR=6

# --- Virtual Fencing (SpatialEngine) ---
# Minimum consecutive frames a spatial state must hold before a transition
# is confirmed (frame-based debounce).
FENCE_DEBOUNCE_FRAMES=3
# Minimum confirmed track-hits before a track is trusted enough to trigger
# a crossing event (guards against a freshly-spawned/re-IDed track).
FENCE_MIN_TRACK_AGE_HITS=10
# Minimum wall-clock milliseconds between repeat crossing events for the
# same track+zone pair (time-based debounce, independent of frame count).
FENCE_EVENT_DEBOUNCE_MS=10000
