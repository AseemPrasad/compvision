# Dependencies (rebuilt inside the image, never copy host node_modules —
# it may contain natives compiled for a different OS/glibc than the image)
node_modules/
npm-debug.log*

# Version control
.git/
.gitignore

# Environment secrets — passed in via docker-compose env_file/environment
# instead, never baked into the image
.env

# Local SQLite database files — persisted via a named volume instead
*.db
*.db-shm
*.db-wal

# Large binary assets that are volume-mounted at runtime rather than
# baked into the image (keeps builds fast and images small; also lets you
# swap models/videos without rebuilding)
ai-engine/models/**
assets/demo_videos/**
!ai-engine/models/.gitkeep
!assets/demo_videos/**/.gitkeep

# Runtime-generated storage — persisted via volumes instead
storage/snapshots/*
storage/clips/*
!storage/snapshots/.gitkeep
!storage/clips/.gitkeep

# Editor/OS noise
.vscode/
.idea/
*.log
.DS_Store
